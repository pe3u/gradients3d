{% macro render(images, captions, prev, next) %}
  {% if captions %}
  <div class="captions">
    {% for c in captions %}<p class="caption">{{ c | safe }}</p>{% endfor %}
  </div>
  {% endif %}

  {% if images %}
  <div class="gallery-grid">
    {% for img in images %}
    <figure class="gallery-item">
      <img src="{{ img.src | url }}" alt="{{ img.alt }}" loading="lazy">
    </figure>
    {% endfor %}
  </div>
  {% endif %}

  {% if prev or next %}
  <nav class="gallery-nav">
    {% if prev %}<a class="prev" href="{{ prev | url }}">&#10218;&#10218; Previous</a>{% endif %}
    {% if next %}<a class="next" href="{{ next | url }}">Next &#10219;&#10219;</a>{% endif %}
  </nav>
  {% endif %}
{% endmacro %}
